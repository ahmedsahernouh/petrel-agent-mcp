{
  "id": "export_well_tops_ascii",
  "version": 1,
  "title": "Export Well Tops ASCII",
  "petrel_version_scope": "Petrel 2018.2 local help with Petrel 2010 demo-project automation copy",
  "strategy": "zero_gui_first_then_deterministic_gui",
  "zero_gui": {
    "preferred_tools": [
      "petrel_export_well_tables_zero_gui",
      "petrel_export_well_tops_native_probe"
    ],
    "current_status": "insufficient_for_confirmed_marker_pick_table",
    "reason": "Zero-GUI tools can derive LAS/native well-top evidence and source-ASCII fallback rows, but confirmed Petrel marker-pick depth rows still require native payload decoding or a Petrel-authored export command.",
    "fallback_allowed": true
  },
  "gui": {
    "adapter": "export_petrel_well_tops_ui.ps1",
    "adapter_mode": "deterministic_micro_tool",
    "default_arguments": {
      "target_subfolder": "02_wells\\well_tops",
      "extension": "txt",
      "format_pattern": "Petrel.*well.*tops.*ASCII|Well Tops.*ASCII",
      "license_profile": "BatchProfile",
      "petrel_option_style": "Slash",
      "drive_letter": "P",
      "timeout_seconds": 900,
      "license_dialog_timeout_seconds": 3,
      "stable_file_ticks": 1,
      "file_poll_seconds": 1,
      "well_tops_relative_x": 91,
      "well_tops_relative_y": 546,
      "export_object_relative_x": 221,
      "export_object_relative_y": 415,
      "context_menu_keyboard": false
    },
    "preconditions": [
      {
        "id": "automation_copy_exists",
        "type": "file_exists",
        "path_template": "{project_file}"
      },
      {
        "id": "export_package_exists",
        "type": "directory_exists",
        "path_template": "{export_package}"
      },
      {
        "id": "well_tops_target_folder_available",
        "type": "directory_create_or_exists",
        "path_template": "{export_package}\\02_wells\\well_tops"
      },
      {
        "id": "interactive_desktop_required",
        "type": "runtime_requirement",
        "value": "Petrel must be visible in the same Windows desktop session as the GUI helper."
      }
    ],
    "state_anchors": [
      {
        "id": "petrel_main_window",
        "type": "window_title_regex",
        "pattern": "Petrel E&P Software Platform"
      },
      {
        "id": "explorer_input_tab_strip",
        "type": "ocr_context_anchor",
        "name": "Input",
        "required_siblings": [
          "Models",
          "Results",
          "Templates"
        ],
        "reject_ancestor_or_header": "Processes"
      },
      {
        "id": "well_tops_tree_item",
        "type": "uia_or_visual_anchor",
        "name": "Well Tops"
      },
      {
        "id": "context_menu_export",
        "type": "uia_menu_text",
        "name": "Export object"
      },
      {
        "id": "export_format",
        "type": "dialog_text_regex",
        "pattern": "Petrel.*well.*tops.*ASCII|Well Tops.*ASCII"
      },
      {
        "id": "crs_confirmation",
        "type": "dialog_text_regex",
        "pattern": "Coordinate reference system selection"
      }
    ],
    "actions": [
      {
        "id": "activate_petrel",
        "primitive": "activate_window",
        "postcondition": "petrel_main_window"
      },
      {
        "id": "select_input_well_tops",
        "primitive": "select_tree_item",
        "path": [
          "Explorer/Input",
          "Wells",
          "Well Tops"
        ],
        "postcondition": "well_tops_tree_item"
      },
      {
        "id": "open_export_object",
        "primitive": "context_menu_select",
        "menu_item": "Export object",
        "postcondition": "export_dialog_visible"
      },
      {
        "id": "choose_ascii_format",
        "primitive": "select_export_format",
        "format_pattern": "Petrel.*well.*tops.*ASCII|Well Tops.*ASCII",
        "postcondition": "export_format"
      },
      {
        "id": "write_output_path",
        "primitive": "file_dialog_set_path",
        "path_template": "{temporary_drive}:\\{output_file_name}",
        "postcondition": "dialog_accepted"
      },
      {
        "id": "confirm_crs",
        "primitive": "dialog_button_click",
        "button": "OK for all",
        "postcondition": "crs_confirmation_handled"
      }
    ],
    "postconditions": [
      {
        "id": "ascii_file_written",
        "type": "file_exists",
        "path_template": "{export_package}\\02_wells\\well_tops\\{output_file_name}"
      },
      {
        "id": "ascii_file_nonempty",
        "type": "file_size_gt",
        "bytes": 0
      },
      {
        "id": "petrel_ascii_parser_succeeds",
        "type": "script_exit_zero",
        "script": "import_petrel_well_tops_ascii_export.py"
      },
      {
        "id": "parsed_marker_pick_rows",
        "type": "json_field_min",
        "field": "row_count",
        "min": 1
      },
      {
        "id": "manifest_validation_passes",
        "type": "validation_status",
        "allowed": [
          "passed",
          "skipped"
        ]
      }
    ],
    "artifacts": [
      "07_workflows_reports\\automation_runs\\deterministic_gui_export_well_tops_ascii_*.json",
      "07_workflows_reports\\automation_runs\\petrel_ui_welltops_export_*.trace.log",
      "07_workflows_reports\\automation_runs\\ui_well_log_export_*\\*.png",
      "02_wells\\well_tops\\well_tops_exportpilot_detgui_*.txt",
      "02_wells\\well_tops\\well_tops_exportpilot_detgui_*.txt.crsmeta.xml",
      "02_wells\\well_tops\\well_tops_from_petrel_ascii_export.csv",
      "02_wells\\well_tops\\well_tops_petrel_ascii_export_vs_gui_compare.csv",
      "02_wells\\well_tops\\well_tops_petrel_ascii_export_vs_source_ascii_compare.csv"
    ],
    "failure_policy": {
      "fail_closed": true,
      "do_not_retry_blindly": true,
      "manual_intervention_when_blocked": "Capture screenshot, trace log, active window title, and native before/after snapshot path before any manual recovery.",
      "known_blockers": [
        "The word Input appears in both the Explorer tab strip and the Processes pane; only Explorer/Input with sibling tabs Models, Results, and Templates is a valid target.",
        "Petrel WinForms tree may not expose Workflow/Input controls through UI Automation.",
        "Windows may deny keyboard input from the non-interactive Codex shell.",
        "Coordinate fallback is allowed only when explicitly requested and still requires output-file validation."
      ]
    }
  },
  "mcp_contract": {
    "tool": "petrel_run_deterministic_gui_workflow",
    "default_mode": "dry_run",
    "execute_argument": "execute",
    "required_output_evidence": [
      "runner_report",
      "ui_driver_status_json",
      "petrel_ascii_import_report",
      "validation_report"
    ]
  }
}
